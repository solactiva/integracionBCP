BASE_URL=https://sandbox.openbanking.bcp.com.bo/Web_ApiQr/api/v4
BASIC_USERNAME=your_basic_username
BASIC_PASSWORD=your_basic_password

# Path where the PFX will be read from by the app
# In Render, keep this path and provide the PFX content via PFX_BASE64 (see below)
MTLS_PFX_PATH=./certs/BCP_SANDBOX_OPENBANKING.pfx
MTLS_PFX_PASSWORD=your_pfx_password

# Optional: only for local dev if you don't have the file on disk
# Provide the PFX content base64-encoded and it will be written to MTLS_PFX_PATH at startup
#PFX_BASE64=

PORT=3030
# Business config
BUSINESS_CODE=
APP_USER_ID=
CITY=
PUBLIC_TOKEN=
